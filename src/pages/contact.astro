---
import Layout from '../components/layout/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { site, displayUrl } from '../config/site';

type Method = { label: string; value: string; href: string; external?: boolean; download?: boolean };

// Built from site config — anything null is simply not listed.
const methods = [
  site.email && { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  site.linkedin && { label: 'LinkedIn', value: displayUrl(site.linkedin), href: site.linkedin, external: true },
  site.github && { label: 'GitHub', value: displayUrl(site.github), href: site.github, external: true },
  site.cv && { label: 'CV', value: 'Download PDF', href: site.cv, download: true },
].filter(Boolean) as Method[];

const lookingFor = [
  'Backend problems at real scale',
  'Teams that care about reliability and correctness',
  'Remote, or on-site in Accra',
];

const labelClass = 'block font-mono text-xs text-subtle mb-1.5';
const inputClass =
  'w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-fg placeholder:text-subtle transition-colors hover:border-line-strong focus:border-line-strong';
---

<Layout
  title="Contact"
  description="Get in touch with Nana Kwame Oparrey Kuhney — backend engineer based in Ghana. Open to senior backend roles and contracts."
>
  <div class="wrap-narrow">
    <header class="pt-16 md:pt-24 animate-fade-up">
      <SectionHeading as="h1" label="Contact" title="Let's talk." />
      {site.availability && (
        <p class="-mt-6 mb-12 flex items-center gap-2.5 text-muted">
          <span class="h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          <span>
            {site.availability}{site.location && <span class="text-subtle"> · {site.location}</span>}
          </span>
        </p>
      )}
    </header>

    {methods.length > 0 && (
      <section class="border-t border-line py-16 animate-fade-up anim-delay-100">
        <h2 class="eyebrow mb-4">Reach me</h2>
        <dl class="border-t border-line">
          {methods.map((m) => (
            <div class="grid gap-x-6 gap-y-1 border-b border-line py-3 sm:grid-cols-[8rem_1fr]">
              <dt class="font-mono text-xs text-subtle sm:pt-0.5">{m.label}</dt>
              <dd class="text-sm">
                <a
                  href={m.href}
                  class="link"
                  target={m.external ? '_blank' : undefined}
                  rel={m.external ? 'noopener noreferrer' : undefined}
                  download={m.download ? true : undefined}
                >
                  {m.value}
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {site.formspreeId ? (
      <section class="border-t border-line py-16">
          <h2 class="text-heading text-fg mb-2">Send a message</h2>
          <p class="mb-8 text-muted">I reply within a couple of days.</p>

          <div id="form-success" class="hidden mb-6 rounded-lg bg-accent-soft px-4 py-3 text-sm text-fg" role="status" aria-live="polite">
            <span class="font-medium">Message sent.</span> I'll be in touch shortly.
          </div>
          <div id="form-error" class="hidden mb-6 rounded-lg border border-line-strong bg-sunken px-4 py-3 text-sm text-fg" role="alert">
            <span class="font-medium">Something went wrong.</span>
            {site.email ? <> Try again, or email <a href={`mailto:${site.email}`} class="link">{site.email}</a>.</> : ' Please try again.'}
          </div>

          <form id="contact-form" action={`https://formspree.io/f/${site.formspreeId}`} method="POST" class="space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class={labelClass}>Name</label>
                <input id="name" name="name" type="text" required autocomplete="name" class={inputClass} />
              </div>
              <div>
                <label for="email" class={labelClass}>Email</label>
                <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} />
              </div>
            </div>
            <div>
              <label for="subject" class={labelClass}>Subject <span class="text-subtle">(optional)</span></label>
              <input id="subject" name="subject" type="text" class={inputClass} />
            </div>
            <div>
              <label for="message" class={labelClass}>Message</label>
              <textarea
                id="message"
                name="message"
                required
                minlength="10"
                rows="6"
                placeholder="What are you building, and where do you need help?"
                class={`${inputClass} resize-y`}
              ></textarea>
            </div>
            {/* Honeypot: Formspree drops submissions that fill this in. */}
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <button
              id="submit-btn"
              type="submit"
              class="inline-flex items-center gap-2 rounded-lg bg-fg text-canvas px-4 py-2.5 text-sm font-medium hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
            >
              Send message
            </button>
          </form>
      </section>
    ) : (
      methods.length > 0 && (
        <p class="-mt-10 pb-16 text-muted">
          Reach me directly through any of the above — I reply within a couple of days.
        </p>
      )
    )}

    <section class="border-t border-line py-16">
      <h2 class="eyebrow mb-4">What I'm looking for</h2>
      <ul class="space-y-2" role="list">
        {lookingFor.map((item) => (
          <li class="relative pl-6 text-fg before:absolute before:left-0 before:top-[0.8em] before:h-px before:w-3 before:bg-line-strong">
            {item}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const success = document.getElementById('form-success');
    const error = document.getElementById('form-error');

    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    // Native constraint validation runs before this fires, so only valid forms get here.
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      success?.classList.add('hidden');
      error?.classList.add('hidden');

      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Sending…';
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          success?.classList.remove('hidden');
          form.reset();
        } else {
          error?.classList.remove('hidden');
        }
      } catch {
        error?.classList.remove('hidden');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Send message';
        }
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>

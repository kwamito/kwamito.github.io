---
import Layout from '../components/layout/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ClosingLine from '../components/ui/ClosingLine.astro';
import { site } from '../config/site';
import { compact } from '../lib/compact';

interface Fact {
  label: string;
  value: string;
  mono?: boolean;
}

const values = [
  {
    title: 'Reliability over cleverness',
    body: 'The most important property of a production system is that it works — consistently, predictably, even at 2am on a public holiday. I design for the failure modes first.',
  },
  {
    title: 'Observability from day one',
    body: 'A system you cannot see is a system you cannot trust. Logging, structured errors and monitoring are part of the design, not afterthoughts.',
  },
  {
    title: 'Simple architectures that scale',
    body: 'The right tool is usually the boring tool. I reach for complexity only when simplicity has run out of room.',
  },
  {
    title: 'Documentation is part of the work',
    body: 'A well-documented API and a clear README are a form of respect for the people who come after you — including future you.',
  },
];

const facts = compact<Fact>([
  site.location && { label: 'Location', value: site.location },
  { label: 'Role', value: 'Lead Backend Engineer, Effect Studios' },
  { label: 'Primary stack', value: 'Python · Django · PostgreSQL · GCP', mono: true },
  { label: 'Interests', value: 'Distributed systems, API design, performance' },
  site.availability && { label: 'Open to', value: site.availability },
  { label: 'Languages', value: 'English, Twi' }, // TODO: update
]);

// Body copy for the reading sections. Not using .prose-content here:
// its paragraph margins doubled up with space-y and left uneven gaps.
const body = 'space-y-5 text-body-lg text-muted';
const h2 = 'text-heading text-fg mb-6';
---

<Layout
  title="About"
  description="Nana Kwame Oparrey Kuhney, Lead Backend Engineer based in Ghana. How I got here, how I work, and what I believe about building software."
>
  <div class="wrap-narrow">
    <header class="pt-16 md:pt-24 animate-fade-up">
      <SectionHeading
        as="h1"
        label="About"
        title="Building software in Ghana, for the world."
        subtitle="I'm Nana Kwame Oparrey Kuhney, a lead backend engineer based in Accra. I design and build the parts of software systems that people don't see but depend on every day."
        class="mb-12"
      />
    </header>

    <section class="border-t border-line py-16 animate-fade-up anim-delay-100">
      <h2 class={h2}>Who I am</h2>
      <div class={body}>
        <p>
          I work on APIs, data systems and cloud infrastructure. That has meant approval workflows that keep a full change history, reporting queries brought down from minutes to under half a second, and the deploy pipelines that ship them.
        </p>
        <p>
          I'm Lead Backend Engineer at <strong class="font-medium text-fg">Effect Studios Limited</strong>, where I own the backend architecture and production operations for several platforms — including the backend for a scholarship programme, which runs the whole award lifecycle for applicants and 12 staff roles.
        </p>
        <p>
          Outside work I build local-first Android apps for the same conditions: Stash, an offline-first budgeting app built for Ghana, and a habit tracker built around idempotent writes. Building for West African infrastructure and its network conditions has sharpened my instincts for systems that hold up in the real world.
        </p>
      </div>
    </section>

    <section class="border-t border-line py-16">
      <h2 class={h2}>How I work</h2>
      <p class={body}>
        Good engineering is a discipline, not a talent. It shows up in what you prioritise before the system breaks, not after.
      </p>
      <ol class="mt-8 border-t border-line">
        {values.map((v, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-line py-5 last:border-b-0">
            <span class="font-mono text-xs text-subtle tabular pt-1">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-semibold text-fg">{v.title}</h3>
              <p class="mt-1 text-muted leading-relaxed">{v.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="border-t border-line py-16">
      <h2 class={h2}>Background</h2>
      <div class={body}>
        <p>
          I learned to build software by building it — personal projects, then freelance work, then production responsibility at a company where the stakes were real and the margin for error was narrow.
        </p>
        <p>
          That gave me an early understanding of what it means for a system to fail in production, and the habit of designing so it doesn't. I've debugged slow queries at midnight and traced failures through distributed logs.
        </p>
      </div>
    </section>

    <section class="border-t border-line py-16">
      <h2 class={h2}>Outside of work</h2>
      {/* TODO: Add a few personal details here — hobbies, interests, etc. */}
      <p class={body}>
        I read widely on distributed systems, database internals and API design. The best engineers are also good writers — clarity of thought and clarity of communication are the same skill.
      </p>
    </section>

    <section class="border-t border-line py-16">
      <h2 class="eyebrow mb-4">Quick facts</h2>
      <dl class="border-t border-line">
        {facts.map(({ label, value, mono }) => (
          <div class="grid gap-x-6 gap-y-1 border-b border-line py-3 sm:grid-cols-[9rem_1fr]">
            <dt class="font-mono text-xs text-subtle sm:pt-0.5">{label}</dt>
            <dd class={`text-sm text-fg ${mono ? 'font-mono' : ''}`}>{value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <ClosingLine lead="Want to talk about a role or a system?" />
  </div>
</Layout>

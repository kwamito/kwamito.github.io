---
import Layout from '../components/layout/Layout.astro';
import Hero from '../components/home/Hero.astro';
import StatsStrip from '../components/home/StatsStrip.astro';
import CTASection from '../components/home/CTASection.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import SkillCard from '../components/SkillCard.astro';
import { getSortedProjects, getPublishedPosts, readingTime } from '../lib/content';

const [leadProject, ...otherProjects] = (await getSortedProjects()).slice(0, 3);
const latestPosts = (await getPublishedPosts()).slice(0, 3);

const coreSkills = [
  {
    title: 'Core backend',
    description: 'APIs, background jobs and domain logic in the Python and Django ecosystem.',
    skills: ['Python', 'Django', 'DRF', 'REST APIs', 'Celery'],
  },
  {
    title: 'Data',
    description: 'PostgreSQL as the source of truth, modelled and tuned for reporting at volume.',
    skills: ['PostgreSQL', 'Query optimization', 'Indexing', 'Materialized views'],
  },
  {
    title: 'Cloud & delivery',
    description: 'Containerised services on Google Cloud with automated pipelines.',
    skills: ['GCP', 'Cloud Run', 'Cloud SQL', 'Docker', 'GitHub Actions'],
  },
];

const section = 'border-t border-line py-20 sm:py-28';
const moreLink = 'link text-sm font-medium';
---

<Layout
  title="Home"
  description="Nana Kwame Oparrey Kuhney — lead backend engineer in Accra, Ghana. Scholarship lifecycle platforms, reporting engines and cloud infrastructure built with Django, PostgreSQL and Google Cloud."
>
  <Hero />
  <StatsStrip />

  <section class={section}>
    <div class="wrap">
      <SectionHeading
        label="Selected work"
        title="Systems in production."
        subtitle="Architecture, trade-offs and outcomes from the platforms I lead."
        class="mb-12"
      />

      <div class="grid gap-6 md:grid-cols-2">
        {leadProject && (
          <div class="md:col-span-2">
            <ProjectCard
              size="lead"
              index={1}
              title={leadProject.data.title}
              description={leadProject.data.description}
              problem={leadProject.data.problem}
              impact={leadProject.data.impact}
              tags={leadProject.data.tags}
              slug={leadProject.id}
              metrics={leadProject.data.metrics}
            />
          </div>
        )}
        {otherProjects.map((project, i) => (
          <ProjectCard
            index={i + 2}
            title={project.data.title}
            description={project.data.description}
            problem={project.data.problem}
            impact={project.data.impact}
            tags={project.data.tags}
            slug={project.id}
          />
        ))}
      </div>

      <p class="mt-10"><a href="/projects/" class={moreLink}>All case studies</a></p>
    </div>
  </section>

  <section class={section}>
    <div class="wrap grid gap-x-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading
          label="Capabilities"
          title="Where I do my best work."
          class="mb-12"
        />
      </div>
      <div class="lg:col-span-8">
        <div class="border-b border-line">
          {coreSkills.map((s) => (
            <SkillCard title={s.title} description={s.description} skills={s.skills} />
          ))}
        </div>
        <p class="mt-10"><a href="/skills/" class={moreLink}>Full skills breakdown</a></p>
      </div>
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class={section}>
      <div class="wrap grid gap-x-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <SectionHeading
            label="Writing"
            title="Notes from the backend."
            subtitle="Lessons from building and operating production systems."
            class="mb-12"
          />
        </div>
        <div class="lg:col-span-8">
          <div class="border-b border-line">
            {latestPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                slug={post.id}
                readingTime={readingTime(post.body ?? '')}
              />
            ))}
          </div>
          <p class="mt-10"><a href="/writing/" class={moreLink}>All writing</a></p>
        </div>
      </div>
    </section>
  )}

  <CTASection />
</Layout>

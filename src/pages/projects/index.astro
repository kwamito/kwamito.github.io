---
import Layout from '../../components/layout/Layout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sorted = projects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout
  title="Projects"
  description="Case studies of production backend systems built by Nana Kwame Oparrey Kuhney — a scholarship lifecycle platform, reporting, cloud infrastructure and local-first mobile apps."
>
  <div class="wrap py-16 sm:py-20">
    <SectionHeading
      as="h1"
      label="Projects"
      title="Production systems, written up as case studies."
      subtitle="A scholarship platform, reporting, infrastructure and two local-first mobile apps. For each: the problem, how the system is built, and what changed."
    />

    <div class="grid gap-6 md:grid-cols-2">
      {sorted.map((project, index) => (
        <div class:list={['grid', index === 0 && 'md:col-span-2']}>
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            problem={project.data.problem}
            impact={project.data.impact}
            tags={project.data.tags}
            slug={project.id}
            featured={project.data.featured}
            index={index + 1}
            size={index === 0 ? 'lead' : 'default'}
          />
        </div>
      ))}
    </div>

    <p class="mt-12 font-mono text-xs text-subtle">
      Client names and sensitive operational details are withheld.
    </p>
  </div>
</Layout>

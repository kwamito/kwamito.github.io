---
import Layout from '../../components/layout/Layout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sorted = projects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout
  title="Projects"
  description="Case studies of production backend systems built by Nana Kwame Oparrey Kuhney — payment platforms, government services, cloud infrastructure, and more."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <SectionHeading
      label="projects"
      title="Production systems & case studies."
      subtitle="Each project represents a real system built for real use. The problems were hard, the stakes were real, and the solutions had to work."
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          problem={project.data.problem}
          impact={project.data.impact}
          tags={project.data.tags}
          slug={project.id}
          featured={project.data.featured}
        />
      ))}
    </div>

    <!-- Note about confidentiality -->
    <p class="mt-12 text-sm text-slate-500 dark:text-slate-500 text-center max-w-xl mx-auto">
      Some systems involve government and financial infrastructure. Case studies describe technical architecture and outcomes without exposing sensitive operational details.
    </p>
  </div>
</Layout>

---
import Layout from '../../components/layout/Layout.astro';
import BackLink from '../../components/ui/BackLink.astro';
import PrevNext from '../../components/ui/PrevNext.astro';
import { render } from 'astro:content';
import { site } from '../../config/site';
import { getSortedProjects } from '../../lib/content';

export async function getStaticPaths() {
  const sorted = await getSortedProjects();
  return sorted.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      position: index + 1,
      total: sorted.length,
      prev: sorted[index - 1] ?? null,
      next: sorted[index + 1] ?? null,
    },
  }));
}

const { project, position, total, prev, next } = Astro.props;
const { Content, headings } = await render(project);
const { title, description, problem, impact, tags, role, period, metrics, stack, links, screenshots } = project.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  keywords: tags.join(', '),
  author: { '@type': 'Person', name: site.name, url: new URL('/', Astro.site).href },
};

const pad = (n: number) => String(n).padStart(2, '0');
const stackList = stack ?? tags;
const toc = headings.filter((h) => h.depth === 2);

// Literal class names so Tailwind can see them.
const metricCols: Record<number, string> = {
  1: 'sm:grid-cols-1',
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-3',
  4: 'sm:grid-cols-4',
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <article class="wrap py-16 sm:py-20">
    <BackLink href="/projects/" label="All projects" />

    <!-- Header -->
    <header class="mt-10 max-w-3xl">
      <p class="eyebrow tabular">Case study {pad(position)} / {pad(total)}</p>
      <h1 class="mt-4 text-title text-fg text-balance" style={`view-transition-name: project-${project.id}; view-transition-class: title-morph`}>{title}</h1>
      <p class="mt-5 text-lg sm:text-xl text-muted leading-relaxed text-pretty">{description}</p>
    </header>

    <!-- Metadata rail -->
    <dl class="mt-12 grid gap-x-10 gap-y-6 border-y border-line py-6 sm:grid-cols-[auto_auto_minmax(0,1fr)]">
      {role && (
        <div>
          <dt class="eyebrow">Role</dt>
          <dd class="mt-2 text-sm text-fg">{role}</dd>
        </div>
      )}
      {period && (
        <div>
          <dt class="eyebrow">Period</dt>
          <dd class="mt-2 text-sm text-fg tabular">{period}</dd>
        </div>
      )}
      <div class:list={[!period && 'sm:col-span-2']}>
        <dt class="eyebrow">Stack</dt>
        <dd class="mt-2 flex flex-wrap font-mono text-[0.8125rem] leading-6 text-fg">
          {stackList.map((item, i) => (
            <span class="whitespace-nowrap">
              {item}{i < stackList.length - 1 && <span class="text-subtle px-1.5" aria-hidden="true">/</span>}
            </span>
          ))}
        </dd>
      </div>
      {links.length > 0 && (
        <div class="sm:col-span-3">
          <dt class="eyebrow">Links</dt>
          <dd class="mt-2 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {links.map((l) => (
              <a href={l.href} class="link" target="_blank" rel="noopener noreferrer">{l.label} <span aria-hidden="true">↗</span></a>
            ))}
          </dd>
        </div>
      )}
    </dl>

    <!-- Metric strip -->
    {metrics.length > 0 && (
      <dl
        class:list={[
          'grid grid-cols-1 divide-y divide-line border-b border-line sm:divide-y-0 sm:divide-x',
          metricCols[Math.min(metrics.length, 4)],
        ]}
      >
        {metrics.map((m) => (
          <div class="flex flex-col-reverse py-6 sm:px-6 sm:first:pl-0">
            <dt class="mt-2 text-sm text-muted leading-snug text-pretty">{m.label}</dt>
            <dd class="tabular text-3xl sm:text-4xl font-semibold tracking-tight text-fg">{m.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <!-- Problem / Outcome -->
    <div class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2">
      <section aria-labelledby="cs-problem">
        <h2 id="cs-problem" class="eyebrow">Problem</h2>
        <p class="mt-3 text-base text-muted leading-relaxed text-pretty">{problem}</p>
      </section>
      <section aria-labelledby="cs-outcome">
        <h2 id="cs-outcome" class="eyebrow">Outcome</h2>
        <p class="mt-3 text-base text-fg leading-relaxed text-pretty">{impact}</p>
      </section>
    </div>

    <!-- Screenshots -->
    {screenshots && screenshots.length > 0 && (
      <section class="mt-14" aria-labelledby="cs-screens">
        <h2 id="cs-screens" class="eyebrow">Screens</h2>
        <ul class="mt-4 flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4" role="list">
          {screenshots.map((s) => (
            <li class="shrink-0 snap-start">
              <img
                src={s.src}
                alt={s.alt}
                loading="lazy"
                decoding="async"
                class="block h-[min(520px,70vh)] w-auto aspect-[9/19.5] rounded-lg border border-line bg-canvas object-cover"
              />
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Body + table of contents -->
    <div class="mt-16 border-t border-line pt-14 lg:grid lg:grid-cols-[minmax(0,43rem)_13rem] lg:justify-between lg:gap-16">
      <div class="prose-content min-w-0">
        <Content />
      </div>

      {toc.length > 2 && (
        <aside class="hidden lg:block" aria-label="On this page">
          <nav class="sticky top-24">
            <p class="eyebrow">On this page</p>
            <ol class="relative mt-4 space-y-2.5 border-l border-line" data-toc>
              <span
                data-toc-indicator
                class="absolute -left-px top-0 w-px bg-accent opacity-0 transition-[transform,height,opacity] duration-300 ease-out-expo"
                aria-hidden="true"
              ></span>
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class="block pl-4 text-sm leading-snug text-muted hover:text-fg aria-[current=location]:text-fg transition-colors"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>

    <PrevNext
      label="More case studies"
      prev={prev && { href: `/projects/${prev.id}/`, title: prev.data.title }}
      next={next && { href: `/projects/${next.id}/`, title: next.data.title }}
      prevLabel="← Previous"
      nextLabel="Next →"
    />
  </article>
</Layout>

<script>
  // Highlight the section being read in the "On this page" list, with a thin accent
  // bar that slides between entries. The active section is the last heading whose top
  // has passed just below the fixed header.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const indicator = toc?.querySelector<HTMLElement>('[data-toc-indicator]');
  const links = [...(toc?.querySelectorAll<HTMLAnchorElement>('[data-toc-link]') ?? [])];
  const headings = links
    .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  if (toc && indicator && headings.length) {
    const OFFSET = 120; // fixed header (64px) plus breathing room
    let current = -1;

    const setActive = (index: number) => {
      if (index === current) return;
      current = index;
      links.forEach((link, i) => {
        if (i === index) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const link = links[index];
      indicator.style.transform = `translateY(${link.offsetTop}px)`;
      indicator.style.height = `${link.offsetHeight}px`;
      indicator.style.opacity = '1';
    };

    const update = () => {
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      if (atBottom) {
        setActive(headings.length - 1);
        return;
      }
      let index = 0;
      headings.forEach((h, i) => {
        if (h.getBoundingClientRect().top - OFFSET <= 0) index = i;
      });
      setActive(index);
    };

    // Only a handful of headings, so measuring on every scroll event is cheap.
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>

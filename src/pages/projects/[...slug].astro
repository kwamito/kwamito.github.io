---
import Layout from '../../components/layout/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = projects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
  return sorted.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: sorted[index - 1] ?? null,
      next: sorted[index + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { title, description, problem, impact, tags } = project.data;
---

<Layout title={title} description={description}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-16">

    <!-- Back link -->
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors mb-8 group"
    >
      <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      All projects
    </a>

    <!-- Header -->
    <header class="mb-10">
      <p class="font-mono text-xs font-medium tracking-widest text-blue-600 dark:text-blue-400 uppercase mb-3">
        case study
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50 mb-4">
        {title}
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
        {description}
      </p>
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <Badge label={tag} variant="default" />
        ))}
      </div>
    </header>

    <!-- Problem / Impact summary card -->
    <div class="grid sm:grid-cols-2 gap-4 mb-10 p-5 bg-slate-50 dark:bg-gray-900/60 border border-slate-200 dark:border-gray-800 rounded-xl">
      <div>
        <p class="font-mono text-xs font-medium text-slate-500 dark:text-slate-500 uppercase tracking-widest mb-1.5">The problem</p>
        <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">{problem}</p>
      </div>
      <div>
        <p class="font-mono text-xs font-medium text-emerald-600 dark:text-emerald-400 uppercase tracking-widest mb-1.5">The impact</p>
        <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">{impact}</p>
      </div>
    </div>

    <hr class="border-slate-200 dark:border-gray-800 mb-10" />

    <!-- MDX content -->
    <div class="prose-content">
      <Content />
    </div>

    <!-- Prev / Next navigation -->
    <nav class="mt-16 pt-8 border-t border-slate-200 dark:border-gray-800" aria-label="Case study navigation">
      <div class="grid grid-cols-2 gap-4">
        <!-- Prev -->
        <div>
          {prev ? (
            <a
              href={`/projects/${prev.id}`}
              class="group flex flex-col p-4 rounded-xl border border-slate-200 dark:border-gray-800 hover:border-blue-300 dark:hover:border-blue-700 hover:bg-slate-50 dark:hover:bg-gray-900 transition-all"
            >
              <span class="flex items-center gap-1 font-mono text-xs text-slate-500 dark:text-slate-500 mb-1.5">
                <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Previous
              </span>
              <span class="text-sm font-medium text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                {prev.data.title}
              </span>
            </a>
          ) : <div />}
        </div>

        <!-- Next -->
        <div>
          {next ? (
            <a
              href={`/projects/${next.id}`}
              class="group flex flex-col items-end p-4 rounded-xl border border-slate-200 dark:border-gray-800 hover:border-blue-300 dark:hover:border-blue-700 hover:bg-slate-50 dark:hover:bg-gray-900 transition-all text-right"
            >
              <span class="flex items-center gap-1 font-mono text-xs text-slate-500 dark:text-slate-500 mb-1.5">
                Next
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
              <span class="text-sm font-medium text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                {next.data.title}
              </span>
            </a>
          ) : <div />}
        </div>
      </div>

      <div class="mt-4 text-center">
        <a
          href="/projects"
          class="text-sm text-slate-500 dark:text-slate-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          Back to all projects
        </a>
      </div>
    </nav>
  </article>
</Layout>

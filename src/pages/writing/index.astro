---
import Layout from '../../components/layout/Layout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { getPublishedPosts, readingTime, formatDate } from '../../lib/content';

const sorted = await getPublishedPosts();

const allTags = [...new Set(sorted.flatMap((p) => p.data.tags))].sort();

// Group posts by year, newest first.
const years = new Map<number, typeof sorted>();
for (const post of sorted) {
  const y = post.data.date.getUTCFullYear();
  years.set(y, [...(years.get(y) ?? []), post]);
}
---

<Layout
  title="Writing"
  description="Technical writing by Nana Kwame Oparrey Kuhney — notes on Django, PostgreSQL, GCP and backend engineering from production experience."
>
  <div class="wrap-narrow py-16 sm:py-20">
    <SectionHeading
      as="h1"
      label="Writing"
      title="Notes from the backend."
      subtitle="Practical lessons from building and running production systems: PostgreSQL, Django, Cloud Run and the workflows on top."
      class={allTags.length > 0 ? 'mb-8' : 'mb-12'}
    />

    {allTags.length > 0 && (
      <div class="mb-12 flex flex-wrap gap-x-4 gap-y-2" role="group" aria-label="Filter posts by tag">
        <button type="button" class="tag-filter" data-tag="all" aria-pressed="true">All</button>
        {allTags.map((tag) => (
          <button type="button" class="tag-filter" data-tag={tag} aria-pressed="false">{tag}</button>
        ))}
      </div>
    )}

    {sorted.length === 0 ? (
      <p class="font-mono text-sm text-subtle">No posts yet.</p>
    ) : (
      <div class="space-y-12">
        {[...years].map(([year, items]) => (
          <section class="year-group" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="eyebrow tabular pb-3 border-b border-line-strong">{year}</h2>
            <ol>
              {items.map((post) => (
                <li class="post-row border-b border-line" data-tags={JSON.stringify(post.data.tags)}>
                  <a href={`/writing/${post.id}/`} class="group grid gap-x-8 gap-y-1 py-6 sm:grid-cols-[4.5rem_minmax(0,1fr)]">
                    <time datetime={post.data.date.toISOString()} class="font-mono text-sm text-subtle tabular sm:pt-0.5">
                      {formatDate(post.data.date, 'dayMonth')}
                    </time>
                    <div>
                      <h3 class="text-lg font-medium leading-snug text-fg text-balance underline decoration-transparent decoration-1 underline-offset-4 group-hover:decoration-line-strong transition-colors">
                        {post.data.title}
                      </h3>
                      <p class="mt-2 text-sm text-muted leading-relaxed text-pretty">{post.data.description}</p>
                      <p class="mt-3 font-mono text-xs text-subtle">
                        <span class="tabular">{readingTime(post.body ?? '')} min read</span>
                        {post.data.tags.length > 0 && <span> · {post.data.tags.join(', ')}</span>}
                      </p>
                    </div>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

      <p id="no-results" class="hidden font-mono text-sm text-subtle">No posts match that tag.</p>
    )}
  </div>
</Layout>

<style>
  .tag-filter {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5rem;
    color: var(--subtle);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    cursor: pointer;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .tag-filter:hover {
    color: var(--fg);
  }

  .tag-filter[aria-pressed='true'] {
    color: var(--fg);
    text-decoration-color: var(--accent);
  }
</style>

<script>
  function initTagFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-filter');
    const rows = document.querySelectorAll<HTMLElement>('.post-row');
    const groups = document.querySelectorAll<HTMLElement>('.year-group');
    const noResults = document.getElementById('no-results');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const active = btn.dataset.tag ?? 'all';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

        rows.forEach((row) => {
          const tags: string[] = JSON.parse(row.dataset.tags ?? '[]');
          row.hidden = active !== 'all' && !tags.includes(active);
        });

        let anyVisible = false;
        groups.forEach((g) => {
          const visible = g.querySelector('.post-row:not([hidden])') !== null;
          g.hidden = !visible;
          anyVisible ||= visible;
        });

        noResults?.classList.toggle('hidden', anyVisible);
      });
    });
  }

  initTagFilter();
</script>

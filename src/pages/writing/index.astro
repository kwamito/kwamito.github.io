---
import Layout from '../../components/layout/Layout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing', ({ data }) => !data.draft);
const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Writing"
  description="Technical writing by Nana Kwame Oparrey Kuhney — notes on Django, PostgreSQL, GCP, payment systems, and backend engineering from production experience."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
    <SectionHeading
      label="writing"
      title="Notes from the backend."
      subtitle="Practical lessons from building and running production systems. No fluff, no hot takes — just things I've actually learned."
    />

    {sorted.length === 0 ? (
      <div class="text-center py-20 text-slate-500 dark:text-slate-500">
        <p class="font-mono text-sm">No posts yet. Check back soon.</p>
      </div>
    ) : (
      <div class="grid sm:grid-cols-2 gap-5">
        {sorted.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            slug={post.id}
          />
        ))}
      </div>
    )}
  </div>
</Layout>

---
import Layout from '../../components/layout/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: sorted[index + 1] ?? null, // older
      next: sorted[index - 1] ?? null, // newer
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const { title, description, date, tags = [] } = post.data;

// Estimate reading time from body (200 wpm average)
const body = post.body ?? '';
const wordCount = body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} description={description}>
  <article class="max-w-2xl mx-auto px-4 sm:px-6 py-16">

    <!-- Back link -->
    <a
      href="/writing"
      class="inline-flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors mb-8 group"
    >
      <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      All writing
    </a>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-3">
        <time datetime={date.toISOString()} class="font-mono text-xs text-slate-500 dark:text-slate-500">
          {formattedDate}
        </time>
        <span class="text-slate-300 dark:text-slate-700" aria-hidden="true">·</span>
        <span class="font-mono text-xs text-slate-500 dark:text-slate-500">{readingTime} min read</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50 mb-4">
        {title}
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed mb-5">
        {description}
      </p>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <Badge label={tag} variant="default" />
          ))}
        </div>
      )}
    </header>

    <hr class="border-slate-200 dark:border-gray-800 mb-10" />

    <!-- MDX content -->
    <div class="prose-content">
      <Content />
    </div>

    <!-- Prev / Next navigation -->
    <nav class="mt-16 pt-8 border-t border-slate-200 dark:border-gray-800" aria-label="Article navigation">
      <div class="grid grid-cols-2 gap-4">
        <!-- Prev (older) -->
        <div>
          {prev ? (
            <a
              href={`/writing/${prev.id}`}
              class="group flex flex-col p-4 rounded-xl border border-slate-200 dark:border-gray-800 hover:border-blue-300 dark:hover:border-blue-700 hover:bg-slate-50 dark:hover:bg-gray-900 transition-all"
            >
              <span class="flex items-center gap-1 font-mono text-xs text-slate-500 dark:text-slate-500 mb-1.5">
                <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Older
              </span>
              <span class="text-sm font-medium text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                {prev.data.title}
              </span>
            </a>
          ) : <div />}
        </div>

        <!-- Next (newer) -->
        <div>
          {next ? (
            <a
              href={`/writing/${next.id}`}
              class="group flex flex-col items-end p-4 rounded-xl border border-slate-200 dark:border-gray-800 hover:border-blue-300 dark:hover:border-blue-700 hover:bg-slate-50 dark:hover:bg-gray-900 transition-all text-right"
            >
              <span class="flex items-center gap-1 font-mono text-xs text-slate-500 dark:text-slate-500 mb-1.5">
                Newer
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
              <span class="text-sm font-medium text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                {next.data.title}
              </span>
            </a>
          ) : <div />}
        </div>
      </div>
    </nav>
  </article>
</Layout>

---
import Layout from '../../components/layout/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      older: sorted[index + 1] ?? null,
      newer: sorted[index - 1] ?? null,
    },
  }));
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags = [] } = post.data;

// Reading time at ~200 wpm.
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formattedDate = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Layout title={title} description={description}>
  <article class="wrap-narrow py-16 sm:py-20">
    <a href="/writing" class="inline-flex items-center gap-2 text-sm text-muted hover:text-fg transition-colors">
      <span aria-hidden="true" class="font-mono">←</span>
      All writing
    </a>

    <header class="mt-10 mb-12 border-b border-line pb-10">
      <p class="eyebrow tabular">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span class="px-2" aria-hidden="true">·</span>
        <span>{readingTime} min read</span>
      </p>
      <h1 class="mt-4 text-title text-fg text-balance">{title}</h1>
      <p class="mt-5 text-lg sm:text-xl text-muted leading-relaxed text-pretty">{description}</p>
      {tags.length > 0 && (
        <p class="mt-6 font-mono text-xs text-subtle">
          <span class="sr-only">Tags: </span>{tags.join(' / ')}
        </p>
      )}
    </header>

    <div class="prose-content">
      <Content />
    </div>

    <nav class="mt-20 grid grid-cols-2 gap-6 border-t border-line pt-8" aria-label="More writing">
      <div>
        {older && (
          <a href={`/writing/${older.id}`} class="group block">
            <span class="eyebrow">← Older</span>
            <span class="mt-2 block text-base font-medium text-fg text-balance underline decoration-transparent decoration-1 underline-offset-4 group-hover:decoration-line-strong transition-colors">
              {older.data.title}
            </span>
          </a>
        )}
      </div>
      <div class="text-right">
        {newer && (
          <a href={`/writing/${newer.id}`} class="group block">
            <span class="eyebrow">Newer →</span>
            <span class="mt-2 block text-base font-medium text-fg text-balance underline decoration-transparent decoration-1 underline-offset-4 group-hover:decoration-line-strong transition-colors">
              {newer.data.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  </article>
</Layout>

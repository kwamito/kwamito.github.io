---
import Layout from '../../components/layout/Layout.astro';
import BackLink from '../../components/ui/BackLink.astro';
import PrevNext from '../../components/ui/PrevNext.astro';
import { render } from 'astro:content';
import { site } from '../../config/site';
import { getPublishedPosts, readingTime, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const sorted = await getPublishedPosts();
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      older: sorted[index + 1] ?? null,
      newer: sorted[index - 1] ?? null,
    },
  }));
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
const minutes = readingTime(post.body ?? '');

const postUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  url: postUrl,
  mainEntityOfPage: postUrl,
  image: new URL('/og-image.png', Astro.site).href,
  keywords: tags.length > 0 ? tags.join(', ') : undefined,
  author: { '@type': 'Person', name: site.name, url: new URL('/', Astro.site).href },
};
---

<Layout title={title} description={description} type="article" publishedTime={date} jsonLd={jsonLd}>
  <article class="wrap-narrow py-16 sm:py-20">
    <BackLink href="/writing/" label="All writing" />

    <header class="mt-10 mb-12 border-b border-line pb-10">
      <p class="eyebrow tabular">
        <time datetime={date.toISOString()}>{formatDate(date, 'long')}</time>
        <span class="px-2" aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <h1 class="mt-4 text-title text-fg text-balance">{title}</h1>
      <p class="mt-5 text-lg sm:text-xl text-muted leading-relaxed text-pretty">{description}</p>
      {tags.length > 0 && (
        <p class="mt-6 font-mono text-xs text-subtle">
          <span class="sr-only">Tags: </span>{tags.join(' / ')}
        </p>
      )}
    </header>

    <div class="prose-content">
      <Content />
    </div>

    <PrevNext
      label="More writing"
      prev={older && { href: `/writing/${older.id}/`, title: older.data.title }}
      next={newer && { href: `/writing/${newer.id}/`, title: newer.data.title }}
      prevLabel="← Older"
      nextLabel="Newer →"
    />
  </article>
</Layout>

---
import Layout from '../components/layout/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { site } from '../config/site';

// TODO: Add additional roles if/when applicable
const roles = [
  {
    title: 'Lead Backend Engineer',
    company: 'Effect Studios Limited',
    period: '2022 — Present',
    location: 'Accra, Ghana',
    type: 'Full-time',
    current: true,
    highlights: [
      'Lead engineer on the backend for the GETFund scholarship programme in Ghana, covering the full award lifecycle: applications, review, interviews and scoring, visa and travel, yearly reconfirmation, tuition and stipend tranches to universities, completion and return. Wrote about 98% of its 1,054 commits since May 2024.',
      'Built the multi-stage approval workflows, including yearly reconfirmation (team lead → finance → audit → admin) and programme completion, for applicants and 12 staff roles, with role-based permissions and row-level locking on concurrent state transitions.',
      'Kept full change history on 56 models so every decision can be audited, backed by 1,085 automated tests.',
      'Built a companion PDF letter service in Node and Puppeteer that generates 16 letter types.',
      'Built a reporting and analytics engine on PostgreSQL materialized views and a read replica, cutting reporting queries from 2–5 minutes to under 500 ms.',
      'Ran production on Google Cloud (App Engine, Cloud Run, Cloud SQL, Secret Manager) with infrastructure in Terraform and GitHub Actions pipelines that cut deploys from 30 minutes by hand to 5 automated.',
      'Implemented error tracking (GlitchTip), structured logging and production performance monitoring across all services.',
      'Set API security practice across our platforms: token-based authentication, signed URLs for asset access, secret rotation via GCP Secret Manager, and rate limiting.',
      'Defined backend engineering standards, documentation practices and onboarding for the engineering team.',
      'Mentored developers on Django, API design, code review and production operations.',
    ],
    tags: [
      'Python',
      'Django',
      'DRF',
      'PostgreSQL',
      'GCP',
      'App Engine',
      'Cloud Run',
      'Cloud SQL',
      'Docker',
      'GitHub Actions',
      'Celery',
      'Redis',
      'GlitchTip',
      'Sentry',
      'Cloud Tasks',
      'Terraform',
      'REST APIs',
    ],
  },
  // TODO: Add earlier roles here if applicable
];
---

<Layout
  title="Experience"
  description="Career history of Nana Kwame Oparrey Kuhney — Lead Backend Engineer at Effect Studios Limited. Workflow platforms, APIs, reporting and cloud infrastructure."
>
  <div class="wrap-narrow">
    <header class="pt-16 md:pt-24 animate-fade-up">
      <SectionHeading
        as="h1"
        label="Experience"
        title="Where I've built things."
        subtitle="Backend architecture and production operations for scholarship, reporting and cloud platforms."
      />
    </header>

    <div class="animate-fade-up anim-delay-100">
      <ExperienceTimeline roles={roles} />
    </div>

    <section class="border-t border-line py-16">
      <h2 class="text-heading text-fg mb-6">Background</h2>
      <div class="space-y-5 text-[1.0625rem] leading-[1.75] text-muted">
        <p>
          My foundation is self-directed study and production work. I study database internals, follow releases of the frameworks I use, read other teams' post-mortems, and build things to test ideas.
        </p>
      </div>
    </section>

    <section class="border-t border-line py-12">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        {site.cv && (
          <a
            href={site.cv}
            download
            class="inline-flex items-center gap-2 rounded-lg bg-fg text-canvas px-4 py-2.5 text-sm font-medium hover:opacity-90"
          >
            Download CV
          </a>
        )}
        <p class="text-muted">
          Hiring for a senior backend role? <a href="/contact/" class="link">Get in touch</a>
        </p>
      </div>
    </section>
  </div>
</Layout>

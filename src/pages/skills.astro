---
import Layout from '../components/layout/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';

const areas = [
  {
    title: 'Core backend',
    use: 'REST API design, workflow and business logic, background jobs and scheduled tasks, with large automated test suites.',
    tools: ['Python', 'Django', 'Django REST Framework', 'Celery', 'Cloud Tasks', 'pytest', 'OpenAPI'],
  },
  {
    title: 'Databases & storage',
    use: 'Data modelling, change history, indexing, materialized views and query optimisation, plus caching.',
    tools: ['PostgreSQL', 'Cloud SQL', 'Redis', 'Google Cloud Storage'],
  },
  {
    title: 'Cloud & infrastructure',
    use: 'Production on Google Cloud managed services and containers, with infrastructure defined in Terraform.',
    tools: ['GCP', 'App Engine', 'Cloud Run', 'Cloud SQL', 'Terraform', 'Docker', 'Linux'],
  },
  {
    title: 'CI/CD & automation',
    use: 'Pipelines that run the test suite on every change and deploy automatically, with rollback to the previous release.',
    tools: ['GitHub Actions', 'Docker', 'Git'],
  },
  {
    title: 'Observability',
    use: 'Error tracking, structured logging, slow-query analysis and health checks.',
    tools: ['GlitchTip / Sentry', 'Structured logging'],
  },
  {
    title: 'Security',
    use: 'Token auth with OTP, role-based permissions, secret management, signed URLs, rate limiting and encryption of sensitive fields.',
    tools: ['JWT', 'GCP Secret Manager', 'Signed URLs'],
  },
  {
    title: 'Mobile (personal projects)',
    use: 'Local-first Android apps that work offline, with on-device storage, idempotent writes and thorough automated tests.',
    tools: ['Expo', 'React Native', 'TypeScript', 'SQLite'],
  },
];
---

<Layout
  title="Skills"
  description="Technical skills of Nana Kwame Oparrey Kuhney: Python, Django, PostgreSQL, Google Cloud, Terraform, CI/CD, observability and backend security."
>
  <div class="wrap">
    <header class="pt-16 md:pt-24 animate-fade-up">
      <SectionHeading
        as="h1"
        label="Skills"
        title="What I know and how I use it."
        subtitle="Seven areas, what I do with each, and the tools behind it."
      />
    </header>

    <section class="border-t border-line py-16 animate-fade-up anim-delay-100" aria-label="Skill areas">
      <div class="hidden md:grid grid-cols-[13rem_1fr_18rem] gap-x-10 pb-4" aria-hidden="true">
        <p class="eyebrow">Area</p>
        <p class="eyebrow">What I do with it</p>
        <p class="eyebrow">Tools</p>
      </div>
      <div class="border-t border-line">
        {areas.map((area) => (
          <div class="grid gap-x-10 gap-y-2 border-b border-line py-6 last:border-b-0 md:grid-cols-[13rem_1fr_18rem]">
            <h2 class="font-semibold text-fg">{area.title}</h2>
            <p class="leading-relaxed text-muted">{area.use}</p>
            <p class="font-mono text-sm leading-relaxed text-subtle md:pt-0.5">{area.tools.join(' · ')}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-line py-12">
      <p class="text-muted">
        Need these applied to your system? <a href="/contact/" class="link">Get in touch</a>
      </p>
    </section>
  </div>
</Layout>

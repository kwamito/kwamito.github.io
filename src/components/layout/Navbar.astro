---
import ThemeToggle from '../ui/ThemeToggle.astro';

const navLinks = [
  { href: '/about/', label: 'About' },
  { href: '/experience/', label: 'Experience' },
  { href: '/projects/', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/skills/', label: 'Skills' },
  { href: '/contact/', label: 'Contact' },
];

const pathname = Astro.url.pathname;
function isActive(href: string) {
  return pathname.startsWith(href);
}
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-line bg-canvas/80 backdrop-blur-md backdrop-saturate-150"
>
  <nav class="wrap h-16 flex items-center justify-between" aria-label="Main navigation">
    <a href="/" class="flex items-baseline gap-2.5 rounded-sm" aria-label="Nana Kwame — home">
      <span class="font-semibold tracking-tight text-fg">Nana Kwame</span>
      <span class="hidden sm:inline font-mono text-xs text-subtle">backend engineer</span>
    </a>

    <div class="flex items-center gap-6">
      <ul class="hidden md:flex items-center gap-6" role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'relative py-1 text-sm transition-colors duration-150',
                isActive(href)
                  ? 'text-fg after:absolute after:inset-x-0 after:-bottom-[19px] after:h-px after:bg-fg'
                  : 'text-muted hover:text-fg',
              ]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-1 md:pl-4 md:border-l md:border-line">
        <ThemeToggle />

        <button
          id="mobile-menu-btn"
          class="md:hidden flex items-center justify-center w-9 h-9 rounded-lg text-muted hover:text-fg hover:bg-sunken transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open navigation menu"
        >
          <svg id="icon-hamburger" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M4 8h16M4 16h16"/>
          </svg>
          <svg id="icon-close" class="hidden w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-canvas animate-slide-down">
    <ul class="wrap py-2 flex flex-col" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'flex items-center justify-between py-3 text-base border-b border-line last:border-0',
              isActive(href) ? 'text-fg font-medium' : 'text-muted',
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
            {isActive(href) && <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16" aria-hidden="true"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('icon-hamburger');
  const closeIcon = document.getElementById('icon-close');

  function setOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    hamburger?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
  }

  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setOpen(false);
      btn?.focus();
    }
  });
</script>

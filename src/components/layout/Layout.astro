---
import '../../styles/global.css';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Backend engineer based in Ghana. I build reliable production systems — workflow platforms, APIs, reporting and cloud infrastructure.',
  ogImage = '/og-image.png',
  noIndex = false,
} = Astro.props;

// Single source of truth for the domain is `site` in astro.config.mjs.
const siteUrl = Astro.site ?? new URL('https://kwamito.github.io');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const fullTitle = title === 'Home' ? 'Nana Kwame Oparrey Kuhney — Backend Engineer' : `${title} | Nana Kwame`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0b" media="(prefers-color-scheme: dark)" />

    <!-- Theme: prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl)} />
    <meta property="og:site_name" content="Nana Kwame — Backend Engineer" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl)} />

    <!-- Analytics: Plausible -->
    <!-- TODO: Sign up at https://plausible.io and add kwamito.github.io as a site.
         If you use a custom domain later, update data-domain to match. -->
    <script
      defer
      data-domain="kwamito.github.io"
      src="https://plausible.io/js/script.js"
      is:inline
    ></script>
  </head>

  <body class="bg-canvas text-fg font-sans">
    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-fg focus:text-canvas focus:rounded-lg focus:font-medium"
    >
      Skip to main content
    </a>

    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>

---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import geistLatinWoff2 from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../../styles/global.css';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import { site } from '../../config/site';
import { compact } from '../../lib/compact';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noIndex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Page-specific structured data, emitted alongside the site-wide Person. */
  jsonLd?: object;
}

const {
  title,
  description = 'Backend engineer based in Ghana. I build reliable production systems — workflow platforms, APIs, reporting and cloud infrastructure.',
  ogImage = '/og-image.png',
  ogImageAlt = `${site.name} — ${site.role}, ${site.location}`,
  noIndex = false,
  type = 'website',
  publishedTime,
  jsonLd,
} = Astro.props;

// Single source of truth for the domain is `site` in astro.config.mjs.
const siteUrl = Astro.site ?? new URL('https://kwamito.github.io');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(ogImage, siteUrl);
const fullTitle = title === 'Home' ? `${site.name} — Backend Engineer` : `${title} | ${site.shortName}`;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', siteUrl).href,
  name: site.name,
  jobTitle: site.role,
  url: siteUrl.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Accra', addressCountry: 'GH' },
  sameAs: compact([site.github, site.linkedin]),
};
const structuredData = jsonLd ? [person, jsonLd] : [person];
// Escape '<' so content can never close the script element early.
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0b" media="(prefers-color-scheme: dark)" />

    <!-- Theme: prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Fonts: self-hosted via @fontsource-variable; preload the latin body face -->
    <link rel="preload" href={geistLatinWoff2} as="font" type="font/woff2" crossorigin />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`Writing — ${site.shortName}`} href={new URL('/rss.xml', siteUrl)} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={`${site.shortName} — Backend Engineer`} />
    <meta property="og:locale" content="en_US" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && <meta property="article:author" content={site.name} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={structuredDataJson} />

    <!-- Analytics: Plausible -->
    <!-- TODO: Sign up at https://plausible.io and add kwamito.github.io as a site.
         If you use a custom domain later, update data-domain to match. -->
    <script
      defer
      data-domain="kwamito.github.io"
      src="https://plausible.io/js/script.js"
      is:inline
    ></script>
  </head>

  <body class="bg-canvas text-fg font-sans">
    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-fg focus:text-canvas focus:rounded-lg focus:font-medium"
    >
      Skip to main content
    </a>

    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>

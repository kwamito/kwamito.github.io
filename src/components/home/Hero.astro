---
// Hero section with API response visual
---

<section class="relative min-h-[92vh] flex items-center overflow-hidden bg-slate-50 dark:bg-gray-950">
  <!-- Dot grid background -->
  <div class="absolute inset-0 bg-dot-grid opacity-60 dark:opacity-100 pointer-events-none" aria-hidden="true"></div>

  <!-- Subtle gradient blob -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-500/5 dark:bg-blue-500/8 rounded-full blur-3xl pointer-events-none translate-x-1/4 -translate-y-1/4" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-cyan-500/5 dark:bg-cyan-500/6 rounded-full blur-3xl pointer-events-none -translate-x-1/4 translate-y-1/4" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-20 grid lg:grid-cols-2 gap-16 items-center w-full">

    <!-- Left: Text content -->
    <div class="animate-fade-up">
      <!-- Label -->
      <p class="font-mono text-xs font-medium tracking-widest text-blue-600 dark:text-blue-400 uppercase mb-5">
        Backend Engineer · Ghana, West Africa
      </p>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 dark:text-slate-50 leading-[1.1] mb-6">
        I build the systems<br />
        <span class="text-gradient">behind the systems.</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 leading-relaxed mb-8 max-w-xl">
        Production APIs, payment platforms, and cloud infrastructure — built
        to be reliable, observable, and ready for real-world load.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-semibold rounded-xl transition-all duration-150 shadow-lg shadow-blue-600/25 hover:shadow-blue-500/30 hover:-translate-y-px"
        >
          View My Work
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="/experience"
          class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900/5 dark:bg-white/5 border border-slate-200 dark:border-gray-700 text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-white/10 hover:border-slate-300 dark:hover:border-gray-500 font-semibold rounded-xl transition-all duration-150 hover:-translate-y-px"
        >
          My Experience
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-semibold transition-colors duration-150"
        >
          Get In Touch
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Right: API response visual -->
    <div class="hidden lg:block animate-fade-up delay-200">
      <div class="relative">
        <!-- Glow effect -->
        <div class="absolute inset-0 bg-blue-500/10 dark:bg-blue-500/15 rounded-2xl blur-xl" aria-hidden="true"></div>

        <!-- Terminal card -->
        <div class="relative bg-gray-900 dark:bg-gray-950 border border-gray-700 dark:border-gray-800 rounded-2xl overflow-hidden shadow-2xl">
          <!-- Terminal bar -->
          <div class="flex items-center gap-1.5 px-4 py-3 bg-gray-800 dark:bg-gray-900 border-b border-gray-700 dark:border-gray-800">
            <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
            <span class="ml-3 font-mono text-xs text-gray-500">GET /api/v1/engineer/status</span>
          </div>

          <!-- Response content -->
          <div class="p-6 font-mono text-sm leading-relaxed">
            <!-- HTTP response line -->
            <p class="mb-4 text-gray-500">
              <span class="text-green-400">HTTP/2</span>
              <span class="text-green-400 ml-2">200</span>
              <span class="text-gray-400 ml-2">OK</span>
            </p>

            <!-- JSON body -->
            <div class="text-gray-300 space-y-1">
              <p><span class="text-gray-600">{"{"}</span></p>
              <p class="pl-4">
                <span class="text-blue-300">"name"</span>
                <span class="text-gray-500">: </span>
                <span class="text-green-300">"Nana Kwame Oparrey Kuhney"</span>
                <span class="text-gray-600">,</span>
              </p>
              <p class="pl-4">
                <span class="text-blue-300">"role"</span>
                <span class="text-gray-500">: </span>
                <span class="text-green-300">"Lead Backend Engineer"</span>
                <span class="text-gray-600">,</span>
              </p>
              <p class="pl-4">
                <span class="text-blue-300">"stack"</span>
                <span class="text-gray-500">: </span>
                <span class="text-gray-600">["</span>
                <span class="text-yellow-300">Python</span>
                <span class="text-gray-600">", "</span>
                <span class="text-yellow-300">Django</span>
                <span class="text-gray-600">", "</span>
                <span class="text-yellow-300">PostgreSQL</span>
                <span class="text-gray-600">", "</span>
                <span class="text-yellow-300">GCP</span>
                <span class="text-gray-600">"],</span>
              </p>
              <p class="pl-4">
                <span class="text-blue-300">"location"</span>
                <span class="text-gray-500">: </span>
                <span class="text-green-300">"Ghana, West Africa"</span>
                <span class="text-gray-600">,</span>
              </p>
              <p class="pl-4">
                <span class="text-blue-300">"status"</span>
                <span class="text-gray-500">: </span>
                <span class="text-green-300">"operational"</span>
                <span class="text-gray-600">,</span>
              </p>
              <p class="pl-4">
                <span class="text-blue-300">"transactions_daily"</span>
                <span class="text-gray-500">: </span>
                <span class="text-purple-300">10000</span>
                <span class="text-gray-600">,</span>
              </p>
              <p class="pl-4">
                <span class="text-blue-300">"uptime"</span>
                <span class="text-gray-500">: </span>
                <span class="text-green-300">"99.9%"</span>
              </p>
              <p><span class="text-gray-600">{"}"}</span></p>
            </div>

            <!-- Blinking cursor -->
            <div class="mt-4 flex items-center gap-2">
              <span class="text-blue-400">$</span>
              <span class="w-2 h-4 bg-blue-400 animate-blink" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

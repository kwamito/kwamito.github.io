---
import { site } from '../../config/site';
---

<section class="pt-16 pb-20 sm:pt-24 sm:pb-28">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-12 lg:items-center">
    <div class="lg:col-span-7 animate-fade-up">
      <p class="eyebrow flex flex-wrap items-center gap-x-2 gap-y-1">
        <span>Lead Backend Engineer</span>
        <span aria-hidden="true">·</span>
        <span>{site.location}</span>
        {site.availability && (
          <>
            <span class="flex basis-full items-center gap-2">
              <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
              {site.availability}
            </span>
          </>
        )}
      </p>

      <h1 class="mt-6 text-display text-fg text-balance">
        Backends for multi-stage workflows where every decision is on the record.
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted text-pretty">
        I design and run Django and PostgreSQL systems on Google Cloud. My flagship is the
        backend for Ghana's GETFund scholarship programme: the full award lifecycle, 12
        staff roles, multi-stage approvals and a change history on every record that matters.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href="/projects/"
          class="inline-flex items-center rounded-lg bg-fg px-5 py-3 text-sm font-medium text-canvas transition-opacity hover:opacity-85"
        >
          Read the case studies
        </a>
        <a href="/contact/" class="link text-sm font-medium">Get in touch</a>
      </div>
    </div>

    <figure class="lg:col-span-5 animate-fade-up anim-delay-200">
      <svg
        viewBox="0 0 480 290"
        class="w-full max-w-md lg:max-w-none text-line-strong"
        role="img"
        aria-labelledby="arch-title arch-desc"
        fill="none"
      >
        <title id="arch-title">Yearly scholarship reconfirmation workflow</title>
        <desc id="arch-desc">
          A scholar's yearly reconfirmation moves through four review stages in order: team lead, finance,
          audit and admin. Admin approval confirms the year; otherwise the reconfirmation is rejected.
        </desc>
        <defs>
          <marker id="arch-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0.5 L7 4 L0 7.5" fill="none" stroke="var(--subtle)" stroke-width="1.2" />
          </marker>
        </defs>

        <!-- Edges -->
        <g stroke="var(--subtle)" stroke-width="1" marker-end="url(#arch-arrow)">
          <path d="M134 44 H173" />
          <path d="M305 44 H344" />
          <path d="M411 68 V118" />
          <path d="M346 144 H307" />
          <path d="M240 168 V218" />
          <path d="M175 144 H136" stroke-dasharray="3 3" />
        </g>

        <!-- Edge labels -->
        <g class="font-mono fill-subtle" font-size="10.5">
          <text x="419" y="97">approve</text>
          <text x="248" y="197">approve</text>
          <text x="155" y="136" text-anchor="middle">reject</text>
        </g>

        <!-- Nodes -->
        <g stroke="currentColor" stroke-width="1" class="fill-surface">
          <rect x="4.5" y="20.5" width="129" height="47" rx="6" />
          <rect x="175.5" y="20.5" width="129" height="47" rx="6" />
          <rect x="346.5" y="20.5" width="129" height="47" rx="6" />
          <rect x="346.5" y="120.5" width="129" height="47" rx="6" />
          <rect x="175.5" y="120.5" width="129" height="47" rx="6" />
          <rect x="4.5" y="120.5" width="129" height="47" rx="6" />
          <rect x="175.5" y="220.5" width="129" height="47" rx="6" />
        </g>

        <g class="font-mono">
          <g font-size="12.5" class="fill-fg" font-weight="500">
            <text x="18" y="41">submitted</text>
            <text x="189" y="41">team lead</text>
            <text x="360" y="41">finance</text>
            <text x="360" y="141">audit</text>
            <text x="189" y="141">admin</text>
            <text x="18" y="141">rejected</text>
            <text x="201" y="241">approved</text>
          </g>
          <g font-size="10.5" class="fill-muted">
            <text x="18" y="57">scholar</text>
            <text x="189" y="57">stage 1</text>
            <text x="360" y="57">stage 2</text>
            <text x="360" y="157">stage 3</text>
            <text x="189" y="157">stage 4</text>
            <text x="18" y="157">not confirmed</text>
            <text x="189" y="257">year confirmed</text>
          </g>
          <circle cx="192" cy="237" r="3" class="fill-accent" />
        </g>
      </svg>
      <figcaption class="mt-4 font-mono text-xs leading-relaxed text-subtle">
        fig. 1 — yearly reconfirmation. Each step is role-checked and row-locked, and
        every change stays in the record's history.
      </figcaption>
    </figure>
  </div>
</section>

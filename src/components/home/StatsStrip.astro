---
const stats = [
  {
    value: 10000,
    suffix: '+',
    label: 'transactions / day',
    detail: 'Government payment platform',
  },
  {
    value: 3,
    suffix: '+',
    label: 'years in production',
    detail: 'Real systems, real stakes',
  },
  {
    value: 5,
    suffix: '+',
    label: 'production backends',
    detail: 'Built, deployed, maintained',
  },
  {
    value: null,
    display: 'GCP',
    suffix: '',
    label: 'cloud infrastructure',
    detail: 'Cloud Run · Cloud SQL · Secret Manager',
  },
];
---

<section class="border-y border-slate-200 dark:border-gray-800 bg-white/60 dark:bg-gray-900/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      {stats.map((stat, i) => (
        <div class="flex flex-col">
          <dt
            class="stat-counter font-mono text-2xl sm:text-3xl font-bold text-slate-900 dark:text-slate-50 tracking-tight"
            data-target={stat.value ?? null}
            data-suffix={stat.suffix}
            data-display={stat.display ?? null}
          >
            {stat.display ?? `0${stat.suffix}`}
          </dt>
          <dd class="mt-1">
            <p class="text-sm font-medium text-slate-700 dark:text-slate-300">{stat.label}</p>
            <p class="text-xs text-slate-500 dark:text-slate-500 mt-0.5">{stat.detail}</p>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  function animateCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.stat-counter');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;

          // Static display (e.g. "GCP")
          if (el.dataset.display) {
            el.textContent = el.dataset.display;
            observer.unobserve(el);
            return;
          }

          const target = parseInt(el.dataset.target ?? '0', 10);
          const suffix = el.dataset.suffix ?? '';
          const duration = 1400;
          const start = performance.now();

          function step(now: number) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            // Ease out cubic
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = Math.round(eased * target);
            el.textContent = current.toLocaleString() + suffix;
            if (progress < 1) requestAnimationFrame(step);
          }

          requestAnimationFrame(step);
          observer.unobserve(el);
        });
      },
      { threshold: 0.3 }
    );

    counters.forEach((el) => observer.observe(el));
  }

  animateCounters();
  document.addEventListener('astro:after-swap', animateCounters);
</script>

---
// Every figure here is stated in a case study or on the experience page.
const stats = [
  {
    value: '1,085',
    label: 'automated tests',
    detail: 'Scholarship platform',
  },
  {
    value: '12',
    label: 'staff roles, scoped permissions',
    detail: 'Plus applicants',
  },
  {
    value: '<500 ms',
    label: 'reporting queries',
    detail: 'Down from 2–5 minutes',
  },
  {
    value: '5 min',
    label: 'automated deploys',
    detail: 'Down from 30 manual',
  },
];
---

<section class="border-t border-line" aria-label="Selected results">
  <div class="wrap">
    <dl class="grid grid-cols-2 lg:grid-cols-4">
      {stats.map((stat, i) => (
        <div
          class:list={[
            'flex flex-col py-8 sm:py-10',
            i % 2 === 1 ? 'border-l border-line pl-5 sm:pl-8' : 'pr-5 sm:pr-8',
            i >= 2 && 'border-t border-line lg:border-t-0',
            i === 2 && 'lg:border-l lg:pl-8',
          ]}
        >
          <dt class="mt-3 text-sm text-fg">
            {stat.label}
            <span class="mt-0.5 block text-xs text-subtle">{stat.detail}</span>
          </dt>
          <dd class="order-first font-mono text-3xl sm:text-4xl font-medium tracking-tight text-fg tabular">
            {stat.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

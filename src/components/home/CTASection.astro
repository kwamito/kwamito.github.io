---
interface Props {
  title?: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = "Let's work together.",
  subtitle = "I'm open to new opportunities, contracts, and interesting problems. If you're building something that matters, reach out.",
  primaryLabel = 'Get In Touch',
  primaryHref = '/contact',
  secondaryLabel = 'View Projects',
  secondaryHref = '/projects',
} = Astro.props;
---

<section class="relative py-24 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-blue-600 dark:bg-blue-900/50" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-dot-grid opacity-20" aria-hidden="true"></div>
  <div class="absolute right-0 top-0 w-80 h-80 bg-cyan-400/20 rounded-full blur-3xl" aria-hidden="true"></div>
  <div class="absolute left-0 bottom-0 w-64 h-64 bg-blue-300/20 rounded-full blur-3xl" aria-hidden="true"></div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
      {title}
    </h2>
    <p class="text-lg text-blue-100 dark:text-blue-200 mb-10 leading-relaxed">
      {subtitle}
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href={primaryHref}
        class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-700 font-semibold rounded-lg hover:bg-blue-50 transition-colors shadow-md"
      >
        {primaryLabel}
      </a>
      <a
        href={secondaryHref}
        class="inline-flex items-center gap-2 px-6 py-3 border border-blue-300/40 dark:border-blue-500/40 text-white font-medium rounded-lg hover:bg-white/10 transition-colors"
      >
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>

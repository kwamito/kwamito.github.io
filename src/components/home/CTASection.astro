---
import { site } from '../../config/site';

interface Props {
  title?: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
  /** Optional quiet text link next to the primary action. */
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = 'Building something that has to stay correct?',
  subtitle = 'I lead backend work on multi-role, workflow-heavy platforms in Django, PostgreSQL and Google Cloud. Tell me what you are building.',
  primaryLabel = 'Get in touch',
  primaryHref = '/contact',
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="border-t border-line py-20 sm:py-28">
  <div class="wrap">
    <div class="card grid gap-10 p-6 sm:p-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        {site.availability && (
          <p class="eyebrow flex items-center gap-2">
            <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            {site.availability}
          </p>
        )}
        <h2 class="mt-5 text-heading text-fg text-balance">{title}</h2>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-muted text-pretty">{subtitle}</p>
      </div>

      <div class="flex flex-col items-start gap-4 lg:col-span-4 lg:items-end">
        <a
          href={primaryHref}
          class="inline-flex items-center rounded-lg bg-fg px-5 py-3 text-sm font-medium text-canvas transition-opacity hover:opacity-85"
        >
          {primaryLabel}
        </a>
        {site.email && (
          <a href={`mailto:${site.email}`} class="link font-mono text-sm">{site.email}</a>
        )}
        {secondaryLabel && secondaryHref && (
          <a href={secondaryHref} class="link text-sm">{secondaryLabel}</a>
        )}
      </div>
    </div>
  </div>
</section>

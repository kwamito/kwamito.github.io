---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  /** Use 'h1' when this is the page title. */
  as?: 'h1' | 'h2';
  /** Spacing below is set by the caller (e.g. "mb-12"). */
  class?: string;
}

const { label, title, subtitle, align = 'left', as: Tag = 'h2', class: className } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto' : '';
const sizeClass = Tag === 'h1' ? 'text-title' : 'text-heading';
---

<div class:list={['max-w-2xl', alignClass, className]}>
  {label && <p class="eyebrow mb-4">{label}</p>}
  <Tag class={`${sizeClass} text-fg text-balance`}>{title}</Tag>
  {subtitle && <p class="mt-4 text-lg text-muted leading-relaxed text-pretty">{subtitle}</p>}
</div>

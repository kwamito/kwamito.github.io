---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { label, title, subtitle, align = 'left' } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto' : '';
---

<div class={`max-w-2xl mb-12 ${alignClass}`}>
  {label && (
    <p class="font-mono text-xs font-medium tracking-widest text-blue-600 dark:text-blue-400 uppercase mb-3">
      {label}
    </p>
  )}
  <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-slate-50 tracking-tight mb-4">
    {title}
  </h2>
  {subtitle && (
    <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
      {subtitle}
    </p>
  )}
</div>

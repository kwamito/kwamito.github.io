---
// ThemeToggle: toggles .dark on <html>, persists to localStorage, and crossfades
// the whole page between themes where the View Transitions API is available.
---

<button
  id="theme-toggle"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
  class="relative flex items-center justify-center w-9 h-9 rounded-lg text-muted hover:text-fg hover:bg-sunken transition-colors duration-150"
>
  <!-- Both icons stay in the DOM so they can rotate past each other. -->
  <svg
    class="theme-icon absolute size-4.5 opacity-0 -rotate-90 scale-50 dark:opacity-100 dark:rotate-0 dark:scale-100"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>

  <svg
    class="theme-icon absolute size-4.5 opacity-100 rotate-0 scale-100 dark:opacity-0 dark:rotate-90 dark:scale-50"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<style>
  .theme-icon {
    /* Tailwind v4 rotate and scale utilities set the individual rotate and scale properties. */
    transition:
      rotate 420ms var(--ease-out-expo),
      scale 420ms var(--ease-out-expo),
      opacity 220ms ease;
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const html = document.documentElement;

  const label = () =>
    btn?.setAttribute(
      'aria-label',
      html.classList.contains('dark') ? 'Switch to light mode' : 'Switch to dark mode',
    );

  const apply = () => {
    html.classList.toggle('dark');
    try {
      localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
    } catch {}
    label();
  };

  label();

  btn?.addEventListener('click', () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Same-document view transition: the old theme fades into the new one
    // (slower than page navigation; see .theme-switching in global.css).
    if (!reduce && 'startViewTransition' in document) {
      html.classList.add('theme-switching');
      document
        .startViewTransition(apply)
        .finished.finally(() => html.classList.remove('theme-switching'));
    } else {
      apply();
    }
  });
</script>

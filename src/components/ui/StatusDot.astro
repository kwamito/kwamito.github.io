---
// Small accent dot used for availability and the active mobile nav item.
// `live` adds a slow, faint glow for the "open to roles" status.
interface Props {
  class?: string;
  live?: boolean;
}

const { class: className, live = false } = Astro.props;
---

{live ? (
  <span class:list={['relative inline-flex size-1.5 shrink-0', className]} aria-hidden="true">
    <span class="status-glow absolute inset-0 rounded-full bg-accent"></span>
    <span class="relative size-1.5 rounded-full bg-accent"></span>
  </span>
) : (
  <span class:list={['size-1.5 shrink-0 rounded-full bg-accent', className]} aria-hidden="true"></span>
)}

<style>
  /* A slow breath, not a ping: the halo swells to ~2.6x and fades, every 3.2 s.
     Reduced motion collapses it to its end state (invisible). */
  .status-glow {
    opacity: 0;
    animation: status-breathe 3.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes status-breathe {
    0% { transform: scale(1); opacity: 0.35; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }
</style>

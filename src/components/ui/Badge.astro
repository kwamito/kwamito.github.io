---
interface Props {
  label: string;
  variant?: 'default' | 'blue' | 'cyan' | 'green' | 'purple' | 'orange';
}

const { label, variant = 'default' } = Astro.props;

const variants: Record<string, string> = {
  default: 'bg-slate-100 dark:bg-gray-800 text-slate-700 dark:text-slate-300',
  blue: 'bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300',
  cyan: 'bg-cyan-50 dark:bg-cyan-950/40 text-cyan-700 dark:text-cyan-300',
  green: 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300',
  purple: 'bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-300',
  orange: 'bg-orange-50 dark:bg-orange-950/40 text-orange-700 dark:text-orange-300',
};
---

<span
  class={`inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-mono font-medium tracking-wide ${variants[variant]}`}
>
  {label}
</span>

---
interface Props {
  label: string;
  variant?: 'default' | 'accent';
}

const { label, variant = 'default' } = Astro.props;

const variants = {
  default: 'border-line text-muted',
  accent: 'border-accent/40 text-accent',
};
---

<span
  class={`inline-flex items-center px-2 py-0.5 rounded-sm border font-mono text-xs leading-5 ${variants[variant]}`}
>
  {label}
</span>

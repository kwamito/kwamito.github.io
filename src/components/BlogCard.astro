---
import Badge from './ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  slug: string;
  readingTime?: number; // minutes
}

const { title, description, date, tags = [], slug, readingTime } = Astro.props;
const href = `/writing/${slug}`;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group relative flex flex-col bg-white dark:bg-gray-900 border border-slate-200 dark:border-gray-800 rounded-xl overflow-hidden hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-md hover:shadow-blue-500/5 hover:-translate-y-0.5 transition-all duration-200">
  <!-- Full-card link -->
  <a href={href} class="absolute inset-0 z-0" aria-label={`Read: ${title}`} tabindex="-1"></a>

  <div class="relative flex flex-col flex-1 p-5 z-10 pointer-events-none">
    <!-- Meta row: date + reading time -->
    <div class="flex items-center gap-3 mb-3">
      <time
        datetime={date.toISOString()}
        class="font-mono text-xs text-slate-500 dark:text-slate-500"
      >
        {formattedDate}
      </time>
      {readingTime && (
        <span class="text-slate-300 dark:text-slate-700" aria-hidden="true">·</span>
        <span class="font-mono text-xs text-slate-500 dark:text-slate-500">{readingTime} min read</span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
      {description}
    </p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-auto">
        {tags.slice(0, 4).map((tag) => (
          <Badge label={tag} variant="default" />
        ))}
      </div>
    )}
  </div>

  <div class="relative px-5 py-3.5 border-t border-slate-100 dark:border-gray-800 z-10">
    <a
      href={href}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 group/link transition-colors"
    >
      Read article
      <svg class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>

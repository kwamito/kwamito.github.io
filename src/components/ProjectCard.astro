---
import Badge from './ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  problem: string;
  impact: string;
  tags: string[];
  slug: string;
  featured?: boolean;
}

const { title, description, problem, impact, tags, slug, featured = false } = Astro.props;
const href = `/projects/${slug}`;
---

<article class="group relative flex flex-col bg-white dark:bg-gray-900 border border-slate-200 dark:border-gray-800 rounded-2xl overflow-hidden hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-lg hover:shadow-blue-500/5 dark:hover:shadow-blue-500/10 hover:-translate-y-0.5 transition-all duration-200">
  {featured && (
    <div class="absolute top-4 right-4 z-10">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-medium bg-blue-600 text-white">
        featured
      </span>
    </div>
  )}

  <a href={href} class="absolute inset-0 z-0" aria-label={`Read case study: ${title}`} tabindex="-1"></a>

  <div class="relative flex flex-col flex-1 p-6 z-10 pointer-events-none">
    <!-- Title -->
    <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors pr-16">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
      {description}
    </p>

    <!-- Problem / Impact -->
    <div class="flex flex-col gap-2.5 mb-5 p-3.5 rounded-lg bg-slate-50 dark:bg-gray-800/50 border border-slate-100 dark:border-gray-700/50">
      <div class="flex gap-2">
        <span class="font-mono text-xs font-medium text-slate-500 dark:text-slate-500 shrink-0 mt-0.5">problem</span>
        <p class="text-xs text-slate-700 dark:text-slate-300">{problem}</p>
      </div>
      <div class="border-t border-slate-200 dark:border-gray-700"></div>
      <div class="flex gap-2">
        <span class="font-mono text-xs font-medium text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5">impact</span>
        <p class="text-xs text-slate-700 dark:text-slate-300">{impact}</p>
      </div>
    </div>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mt-auto">
      {tags.slice(0, 5).map((tag) => (
        <Badge label={tag} variant="default" />
      ))}
    </div>
  </div>

  <!-- Footer link -->
  <div class="relative px-6 py-4 border-t border-slate-100 dark:border-gray-800 z-10">
    <a
      href={href}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 group/link transition-colors"
    >
      Read case study
      <svg class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>

---
interface Props {
  title: string;
  description: string;
  problem: string;
  impact: string;
  tags: string[];
  slug: string;
  /** Accepted for backward compatibility; no longer rendered. */
  featured?: boolean;
  /** 1-based position, rendered as a mono index (01, 02, …). */
  index?: number;
  /** 'lead' renders a wide two-column layout for the first case study. */
  size?: 'default' | 'lead';
  /** Shown on the lead card only; the first three are used. */
  metrics?: { value: string; label: string }[];
}

const { title, description, problem, impact, tags, slug, index, size = 'default', metrics = [] } = Astro.props;
const href = `/projects/${slug}/`;
const isLead = size === 'lead';
const num = index !== undefined ? String(index).padStart(2, '0') : null;
const tagLine = tags.slice(0, isLead ? 6 : 4).join(' · ');
---

<article
  data-card
  class:list={[
    'card flex h-full cursor-pointer flex-col transition-colors hover:border-line-strong',
    isLead ? 'p-6 sm:p-10 md:grid md:grid-cols-12 md:gap-10' : 'p-6',
  ]}
>
  <div class:list={['flex flex-col', isLead && 'md:col-span-6']}>
    {num && <p class="font-mono text-xs text-subtle tabular">{num}</p>}

    <h3
      class:list={[
        'text-fg text-balance',
        num && 'mt-4',
        isLead ? 'text-heading' : 'text-lg font-semibold leading-snug tracking-tight',
      ]}
    >
      <a href={href} data-card-link class="focus-visible:outline-offset-4">
        {title}
      </a>
    </h3>

    <p class:list={['mt-3 text-muted leading-relaxed text-pretty', isLead ? 'text-base' : 'text-sm']}>
      {description}
    </p>

    {isLead && metrics.length > 0 && (
      <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-line pt-6">
        {metrics.slice(0, 3).map((m) => (
          <div class="flex flex-col gap-1">
            <dt class="text-xs leading-snug text-subtle text-pretty">{m.label}</dt>
            <dd class="order-first text-2xl font-semibold tracking-tight text-fg tabular">{m.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {!isLead && (
      <p class="mt-4 text-sm leading-relaxed text-fg line-clamp-3">
        <span class="eyebrow mr-2">Outcome</span>{impact}
      </p>
    )}

    <p class:list={['font-mono text-xs text-subtle', isLead ? 'mt-6 md:mt-auto md:pt-8' : 'mt-auto pt-6']}>
      {tagLine}
    </p>
  </div>

  {isLead && (
    <div class="mt-8 border-t border-line md:col-span-6 md:mt-0 md:border-t-0 md:border-l md:pl-10">
      <dl>
        <div class="py-5 md:pt-0">
          <dt class="eyebrow">Problem</dt>
          <dd class="mt-2 text-sm leading-relaxed text-muted text-pretty">{problem}</dd>
        </div>
        <div class="border-t border-line pt-5">
          <dt class="eyebrow">Outcome</dt>
          <dd class="mt-2 text-sm leading-relaxed text-fg text-pretty">{impact}</dd>
        </div>
      </dl>
      <p class="mt-6 font-mono text-xs text-subtle" aria-hidden="true">Read the case study →</p>
    </div>
  )}
</article>

<script>
  // Whole-card click without overlaying the text: navigate via the card's single
  // link unless the user is selecting text or clicked another interactive element.
  const w = window as typeof window & { __cardClickBound?: boolean };
  if (!w.__cardClickBound) {
    w.__cardClickBound = true;
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const card = target?.closest<HTMLElement>('[data-card]');
      if (!card || target?.closest('a, button, input, select, textarea')) return;
      if (window.getSelection()?.toString()) return;
      const link = card.querySelector<HTMLAnchorElement>('[data-card-link]');
      if (!link) return;
      if (e.metaKey || e.ctrlKey) window.open(link.href, '_blank', 'noopener');
      else link.click();
    });
  }
</script>

---
// Renders roles as CV entries. The dot/line timeline was dropped:
// with a single role it added decoration without structure.
interface Role {
  title: string;
  company: string;
  period: string;
  location: string;
  type: string; // Full-time, Contract, etc.
  highlights: string[];
  tags: string[];
  current?: boolean;
}

interface Props {
  roles: Role[];
}

const { roles } = Astro.props;
---

<div>
  {roles.map((role) => (
    <article class="border-t border-line py-16">
      <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <div>
          <h2 class="text-xl font-semibold tracking-tight text-fg">{role.title}</h2>
          <p class="mt-1 text-muted">{role.company}</p>
        </div>
        <div class="sm:text-right">
          <p class="font-mono text-sm tabular text-fg">{role.period}</p>
          <p class="mt-1 font-mono text-xs text-subtle">{role.location} · {role.type}</p>
        </div>
      </header>

      <ul class="mt-8 space-y-3" role="list">
        {role.highlights.map((highlight) => (
          <li class="relative pl-6 leading-relaxed text-muted before:absolute before:left-0 before:top-[0.8em] before:h-px before:w-3 before:bg-line-strong">
            {highlight}
          </li>
        ))}
      </ul>

      <div class="mt-8 grid gap-x-6 gap-y-1 sm:grid-cols-[5rem_1fr]">
        <p class="eyebrow sm:pt-0.5">Stack</p>
        <p class="font-mono text-sm leading-relaxed text-muted">{role.tags.join(' · ')}</p>
      </div>
    </article>
  ))}
</div>

---
interface Props {
  title: string;
  description: string;
  skills: string[];
  icon: 'backend' | 'database' | 'cloud' | 'cicd' | 'observability' | 'security';
}

const { title, description, skills, icon } = Astro.props;

const icons: Record<string, string> = {
  backend: `<path d="M4 6l8-4 8 4-8 4-8-4z"/><path d="M4 10l8 4 8-4"/><path d="M4 14l8 4 8-4"/>`,
  database: `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>`,
  cloud: `<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>`,
  cicd: `<polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/>`,
  observability: `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`,
  security: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
};
---

<div class="flex flex-col bg-white dark:bg-gray-900 border border-slate-200 dark:border-gray-800 rounded-xl p-5 hover:border-slate-300 dark:hover:border-gray-700 transition-colors">
  <!-- Icon + Title -->
  <div class="flex items-start gap-3 mb-3">
    <div class="flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <Fragment set:html={icons[icon]} />
      </svg>
    </div>
    <div>
      <h3 class="font-semibold text-slate-900 dark:text-slate-100 text-sm">{title}</h3>
      <p class="text-xs text-slate-500 dark:text-slate-500 mt-0.5 leading-relaxed">{description}</p>
    </div>
  </div>

  <!-- Skills list -->
  <div class="flex flex-wrap gap-1.5 mt-2">
    {skills.map((skill) => (
      <span class="px-2 py-0.5 rounded text-xs font-mono text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-gray-800 border border-slate-200/60 dark:border-gray-700/60">
        {skill}
      </span>
    ))}
  </div>
</div>

---
interface Props {
  title: string;
  description: string;
  skills: string[];
  depth?: string; // e.g. "3+ years, production systems"
}

const { title, description, skills, depth } = Astro.props;
---

<div class="@container border-t border-line py-6">
  <div class="grid gap-3 @xl:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] @xl:gap-10">
    <div>
      <h3 class="text-base font-semibold tracking-tight text-fg">{title}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{description}</p>
      {depth && <p class="mt-2 font-mono text-xs text-subtle">{depth}</p>}
    </div>
    <p class="font-mono text-sm leading-relaxed text-fg @xl:pt-0.5">
      {skills.join(' · ')}
    </p>
  </div>
</div>
